<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>
<h1>Calculator</h1>
<table>
    <tr>
        <td><input type="number" id="num1" placeholder="Điền số thứ nhất."></td>
        <td><input type="number" id="num2" placeholder="Điền số thứ hai."></td>
    </tr>
    <tr>
        <td><button onclick="add()">Addition(+)</button></td>
        <td><button onclick="subtract()">Subtraction(-)</button></td>
        <td><button onclick="multiply()">Multiply(x)</button></td>
        <td><button onclick="divide()">Division(/)</button></td>
    </tr>
    <tr>
        <td colspan="4">Result: <span id="result"></span></td>
    </tr>
</table>
</body>
</html>